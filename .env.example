# Токен Telegram-бота ассистента (для тебя: заказы, статусы, напоминания)
TELEGRAM_BOT_TOKEN=

# Токен клиентского бота (Mini App для отслеживания заказов клиентами)
# Создай второго бота у @BotFather и впиши его токен сюда
CLIENT_BOT_TOKEN=

# Твой личный Telegram chat_id (бот присылает напоминания и уведомления только тебе)
# Как узнать: напиши боту /start, в логах/консоли увидишь свой chat_id, впиши его сюда
OWNER_CHAT_ID=

# Ключ Gemini API (получить на aistudio.google.com/apikey)
GEMINI_API_KEY=

# ID Google-таблицы (это часть ссылки между /d/ и /edit)
# Пример ссылки: https://docs.google.com/spreadsheets/d/ВОТ_ЭТО_ID/edit
GOOGLE_SHEET_ID=

# Название листа с заказами
GOOGLE_SHEET_WORKSHEET=Заказы

# Путь к json-файлу сервисного аккаунта Google (положи его в корень проекта)
GOOGLE_CREDENTIALS_FILE=credentials.json

# Альтернатива для хостинга: всё содержимое credentials.json одной строкой.
# Если задано, файл создастся при старте — удобно, когда сам json не деплоится.
GOOGLE_CREDENTIALS_JSON=

# Часовой пояс для напоминаний
TIMEZONE=Europe/Moscow

# Папка для баз данных, которые должны переживать передеплой.
# Локально можно не задавать — файлы лягут в корень проекта.
# На хостинге — путь примонтированного постоянного диска, например /data
DATA_DIR=

# Через сколько дней без смены статуса заказ считается зависшим
STUCK_ORDER_DAYS=10

# Краткое описание твоего канала — используется при разборе конкурентов,
# чтобы Gemini мог сравнивать их с тобой
OWN_CHANNEL_DESCRIPTION="Современный сервис доставки товаров из Китая. Работаем через менеджера, присылаем фото товара - находим лучший вариант по низкой цене. Доставка 12-15 дней Китай-Москва."

# Ссылка на задеплоенный Telegram Mini App (страница webapp/index.html).
# Кнопка «📦 Мои заказы» появится в клиентском боте после деплоя, например:
# https://your-app.up.railway.app/app/
MINI_APP_URL=

# Название бренда в Mini App (по умолчанию PR0JECT)
BRAND_NAME=PR0JECT

# Порт для встроенного API трекера заказов. Railway подставляет его сам,
# для локального запуска можно оставить по умолчанию.
PORT=8080
